# ===========================================
# Bot Environment Variables - Example
# ===========================================
# Copy this file to .env and fill in your values.
# On Railway/Render, add these as environment variables in the dashboard.

# ----- Telegram Bot Token -----
# Get it from @BotFather on Telegram
BOT_TOKEN=8860414927:AAGxO3Pdyq-ZaIL6ZFJOerYnWhtef3JxGXA

# ----- PostgreSQL Database (Supabase) -----
# Direct connection string for the bot to read/write data.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://bot_user:akbot2025secure@db.ildwjbvnmyvmzbscdgiu.supabase.co:5432/postgres

# ----- Supabase REST API (optional, for edge functions) -----
VITE_SUPABASE_URL=https://ildwjbvnmyvmzbscdgiu.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ----- Database Pool Settings (optional) -----
DB_POOL_SIZE=10
DB_TIMEOUT=30

# ----- Performance (optional) -----
MAX_WORKERS=50
CACHE_TTL=300
